{
  "appId": "app.lovable.wtracker",
  "appName": "Whealth Factory",
  "webDir": "dist",
  "backgroundColor": "#0a0710",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0a0710",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true,
      "backgroundColor": "#00000000"
    },
    "Keyboard": {
      "resize": "none",
      "style": "DARK",
      "resizeOnFullScreen": false
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "backgroundColor": "#0a0710",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  },
  "server": {
    "url": "https://status-level-up.lovable.app",
    "hostname": "status-level-up.lovable.app",
    "androidScheme": "https"
  }
}
