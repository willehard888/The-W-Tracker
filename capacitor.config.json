{
  "appId": "app.lovable.wtracker",
  "appName": "Whealth Factory",
  "webDir": "dist",
  "backgroundColor": "#0a0710",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#0a0710",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": true,
    "scheme": "app"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true,
      "backgroundColor": "#00000000"
    },
    "Keyboard": {
      "resize": "none",
      "style": "DARK",
      "resizeOnFullScreen": false
    },
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 600,
      "backgroundColor": "#0a0710",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    }
  },
  "server": {
    "androidScheme": "https"
  },
  "packageClassList": [
    "AppLauncherPlugin",
    "AppPlugin",
    "FilesystemPlugin",
    "HapticsPlugin",
    "HealthPlugin",
    "LocalNotificationsPlugin",
    "PurchasesPlugin",
    "PushNotificationsPlugin",
    "SharePlugin",
    "StatusBarPlugin"
  ]
}
