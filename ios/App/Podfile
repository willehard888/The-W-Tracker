require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'

# Use dynamic frameworks, as the official Capacitor 8 iOS template does.
#
# We deliberately DO NOT pass `:modular_headers => true` on the Capacitor pods
# below. Under Xcode 26.4.1 that flag forces CocoaPods to emit its own Clang
# modulemaps for Capacitor/CapacitorCordova, which then conflict with the
# framework modulemaps shipped inside the pod (`Capacitor.modulemap`,
# `CapacitorCordova.modulemap`). The result is a SwiftCompile failure on
#   CAPInstanceDescriptor.h:5 — `error: module 'Cordova' not found`
# because `@import Cordova;` resolves against the CocoaPods-generated map
# while the framework header is searched via FRAMEWORK_SEARCH_PATHS.
#
# Leaving the default header mode (no `:modular_headers`) matches the template
# that ships in `@capacitor/cli/assets/ios-pods-template.tar.gz` and lets the
# pods' own `.modulemap` files (which *do* define module Cordova) drive the
# import — which is how `@import Cordova;` is meant to resolve.
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorAppLauncher', :path => '../../node_modules/@capacitor/app-launcher'
  pod 'CapacitorBrowser', :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'RevenuecatPurchasesCapacitor', :path => '../../node_modules/@revenuecat/purchases-capacitor'
end

target 'App' do
  capacitor_pods
end

post_install do |installer|
  assertDeploymentTarget(installer)

  invalid_toolchain_path = '$(TOOLCHAIN_DIR)/usr/lib/swift/$(PLATFORM_NAME)'
  no_verify_flag = '-Xfrontend -no-verify-emitted-module-interface'

  # Xcode 26.4.1's Swift 6 type-checker crashes (ASSERT_failure in
  # ConstraintSystem::addFix → abort()) while type-checking Capacitor.swift.
  # Confirmed via swift-frontend .ips crash report. Pinning Capacitor's Swift
  # target to Swift 5 + -Onone routes around the broken constraint solver.
  capacitor_swift_targets = %w[Capacitor RevenuecatPurchasesCapacitor]

  # Cordova module visibility:
  # `@import Cordova;` (in CAPInstanceDescriptor.h) MUST resolve via the
  # Cordova.framework that CocoaPods builds for the CapacitorCordova pod —
  # NOT via Pods/Target Support Files/CapacitorCordova/CapacitorCordova.modulemap.
  # That modulemap declares `umbrella header "CapacitorCordova.h"` as a
  # *relative* path, but CapacitorCordova.h does NOT live next to it — it is
  # copied into Cordova.framework/Headers/ at build time. Forcing swift-frontend
  # to load that modulemap via -fmodule-map-file therefore explodes with:
  #   error: umbrella header 'CapacitorCordova.h' not found
  #   error: could not build module 'Cordova'
  # The framework modulemap inside the built Cordova.framework is the correct
  # one — FRAMEWORK_SEARCH_PATHS (set by CocoaPods) already points at it.
  # So we DO NOT inject SWIFT_INCLUDE_PATHS / HEADER_SEARCH_PATHS / fmodule-map-file
  # for Cordova here. Leaving CocoaPods' own search paths in place is what works.

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      library_search_paths = Array(config.build_settings['LIBRARY_SEARCH_PATHS'])
      framework_search_paths = Array(config.build_settings['FRAMEWORK_SEARCH_PATHS'])
      swift_include_paths = Array(config.build_settings['SWIFT_INCLUDE_PATHS'])
      header_search_paths = Array(config.build_settings['HEADER_SEARCH_PATHS'])

      config.build_settings['LIBRARY_SEARCH_PATHS'] = library_search_paths.reject { |p| p == invalid_toolchain_path }
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] = framework_search_paths.reject { |p| p == invalid_toolchain_path }
      config.build_settings['SWIFT_INCLUDE_PATHS'] = swift_include_paths.reject { |p| p == invalid_toolchain_path }

      # Xcode 26: explicit modules + Cordova ObjC headers = SwiftCompile crash.
      config.build_settings['SWIFT_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['CLANG_ENABLE_EXPLICIT_MODULES'] = 'NO'
      config.build_settings['SWIFT_VERIFY_EMITTED_MODULE_INTERFACE'] = 'NO'

      # Apply the Xcode 26 module-interface verification workaround to EVERY Swift pod
      # target (not just Capacitor + RevenueCat). Cheap, idempotent, prevents drift.
      existing_flags = config.build_settings['OTHER_SWIFT_FLAGS'] || '$(inherited)'
      existing_flags = existing_flags.is_a?(Array) ? existing_flags.join(' ') : existing_flags
      unless existing_flags.include?('-no-verify-emitted-module-interface')
        existing_flags = "#{existing_flags} #{no_verify_flag}"
      end
      config.build_settings['OTHER_SWIFT_FLAGS'] = existing_flags

      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'

      # Targeted workaround for the Swift 6 constraint-solver crash on Capacitor.swift.
      if capacitor_swift_targets.include?(target.name)
        config.build_settings['SWIFT_VERSION'] = '5.0'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
        config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
        # Bare `-disable-availability-checking` is a swift-frontend flag, not
        # a swift-driver flag. Passing it directly produces:
        #   Save unknown driver flag -disable-availability-checking as additional swift-frontend flag
        # which Xcode 26 escalates into [Swift Compiler Error] in xcresult.
        # Wrap in `-Xfrontend` so the driver forwards it correctly.
        extra = '-Xfrontend -disable-availability-checking'
        unless config.build_settings['OTHER_SWIFT_FLAGS'].to_s.include?('-disable-availability-checking')
          config.build_settings['OTHER_SWIFT_FLAGS'] = "#{config.build_settings['OTHER_SWIFT_FLAGS']} #{extra}"
        end
      end

      # NOTE: We intentionally do NOT inject SWIFT_INCLUDE_PATHS,
      # HEADER_SEARCH_PATHS, or -fmodule-map-file flags pointing at
      # Pods/Target Support Files/CapacitorCordova/CapacitorCordova.modulemap.
      # That modulemap declares its umbrella header relatively, but the header
      # is built into Cordova.framework/Headers/ — so forcing the modulemap to
      # load via -fmodule-map-file fails with:
      #   error: umbrella header 'CapacitorCordova.h' not found
      # Letting CocoaPods' default FRAMEWORK_SEARCH_PATHS find Cordova.framework
      # is the correct path; `@import Cordova;` resolves via the framework's
      # own Modules/module.modulemap, where the umbrella header lives next to it.
    end
  end
  # Xcode 26 parallel build fix: explicit Capacitor → CapacitorCordova dependency.
  # Without this, Xcode 26's parallel scheduler starts compiling both targets
  # simultaneously. Capacitor tries @import Cordova before CapacitorCordova.framework
  # is linked — causing: error: module 'Cordova' not found
  cap_target     = installer.pods_project.targets.find { |t| t.name == 'Capacitor' }
  cordova_target = installer.pods_project.targets.find { |t| t.name == 'CapacitorCordova' }

  # Step 1: Capacitor waits for CapacitorCordova
  if cap_target && cordova_target
    unless cap_target.dependencies.map(&:name).include?('CapacitorCordova')
      cap_target.add_dependency(cordova_target)
      puts '✅ Added Capacitor → CapacitorCordova dependency'
    end
  end

  # Step 2: All plugin targets wait for Capacitor.
  # Without this, Xcode 26 starts HapticsPlugin/AppPlugin/etc. in parallel
  # with Capacitor. Their Swift compiler builds the Capacitor ObjC module
  # inline → hits @import Cordova → Cordova.framework missing → crash.
  if cap_target
    installer.pods_project.targets.each do |target|
      next if %w[Capacitor CapacitorCordova].include?(target.name)
      next if target.name.start_with?('Pods-')
      next if target.product_type == 'com.apple.product-type.bundle'
      next if target.dependencies.map(&:name).include?('Capacitor')
      target.add_dependency(cap_target)
      puts "✅ Added #{target.name} → Capacitor dependency"
    end
  end

end
